# Required: Xledger GraphQL API token
# Generate at: Xledger > Administration > System Access > GraphQL/API tokens
# Keep the token out of version control and out of project-scoped MCP config files.
XLEDGER_GRAPHQL_TOKEN=your-token-here

# Optional: Override the API endpoint (defaults to https://www.xledger.net/graphql)
# XLEDGER_API_URL=https://demo.xledger.net/graphql

# Optional: GDPR Art. 9 override for all guarded tools (get_absences,
# get_timesheets, get_consultant_profitability, get_expenses,
# get_journal_entries). By default, health-related absence (sick leave, care
# of a sick child, and any absence type not recognised as non-health) is only
# returned as an anonymous aggregate, and absence or health-related project and
# time-type names in per-person rows are replaced. Setting this to 1 lets a
# caller request per-person detail with includeHealthDetail=true. Only the data
# controller should set this, and only with a documented lawful basis. Leave
# unset otherwise.
# XLEDGER_ALLOW_ART9_DETAIL=1
